<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Device Fingerprint Test</title>
</head>
<body>
  <h2>Device Fingerprint Test</h2>
  <pre id="output">Loading...</pre>

  <script>
    (async () => {
      // Load FingerprintJS from CDN (Browser only)
      const fp = await import('https://openfpcdn.io/fingerprintjs/v3')
      const agent = await fp.load()

      const result = await agent.get()

      const payload = {
        visitorId: result.visitorId,
        confidence: result.confidence.score,
        components: Object.keys(result.components)
      }

      document.getElementById('output').textContent =
        JSON.stringify(payload, null, 2)

      // Send to backend
      fetch('http://localhost:5000/api/test', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      })
        .then(res => res.json())
        .then(data => {
          console.log('Backend response:', data)
        })
        .catch(err => {
          console.error('Error sending fingerprint:', err)
        })
    })()
  </script>
</body>
</html>
