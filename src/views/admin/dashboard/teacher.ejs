    <div id="toast-message"></div>

    <script>
        // === Global Variables ===
        const html = document.documentElement;
        const body = document.body;
        
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');
        const toggleSidebarBtn = document.getElementById('toggle-sidebar-btn');
        const closeSidebarBtn = document.getElementById('close-sidebar-btn'); 

        const tableBody = document.getElementById('teachers-table-body');
        const searchInput = document.getElementById('search-input');
        const statusFilter = document.getElementById('status-filter');
        const paginationInfo = document.getElementById('pagination-info');
        const paginationControls = document.getElementById('pagination-controls');

        const teacherModal = document.getElementById('teacher-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalContent = document.getElementById('modal-content');
        const addTeacherBtn = document.getElementById('add-teacher-btn');
        const teacherForm = document.getElementById('teacher-form');
        const toastMessage = document.getElementById('toast-message');

        let currentPage = 1;
        let currentLimit = 10;
        let currentSearch = '';
        let currentStatus = 'all';

        // === Toast Message Function ===
        function showToast(msg, type = 'success', duration = 3500) {
            if (!msg || msg.trim() === '') return;
            
            toastMessage.textContent = msg;
            toastMessage.className = `toast-show toast-${type}`;
            
            setTimeout(() => {
                toastMessage.classList.remove('toast-show');
            }, duration);
        }

        // === Sidebar & Theme ===
        function toggleSidebar() {
            body.classList.toggle('sidebar-open');
            if (body.classList.contains('sidebar-open')) {
                sidebar.classList.remove('transform', 'translate-x-full'); 
                sidebar.classList.add('translate-x-0'); 
                sidebarOverlay.classList.remove('hidden');
                body.style.overflow = 'hidden'; 
            } else {
                sidebar.classList.remove('translate-x-0');
                sidebar.classList.add('transform', 'translate-x-full'); 
                sidebarOverlay.classList.add('hidden');
                body.style.overflow = ''; 
            }
        }
        toggleSidebarBtn.addEventListener('click', toggleSidebar);
        closeSidebarBtn.addEventListener('click', toggleSidebar);
        sidebarOverlay.addEventListener('click', toggleSidebar);

        const themeBtn = document.getElementById('theme-btn');
        const themeIcon = themeBtn.querySelector('i');
        function updateThemeIcon() {
            themeIcon.textContent = html.classList.contains('dark') ? 'light_mode' : 'brightness_4';
        }
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            html.classList.add('dark');
        } else {
            html.classList.remove('dark');
        }
        updateThemeIcon();
        themeBtn.addEventListener('click', () => {
            html.classList.toggle('dark');
            localStorage.theme = html.classList.contains('dark') ? 'dark' : 'light';
            updateThemeIcon();
        });

        // === API Functions ===
        async function fetchTeachers() {
            try {
                const params = new URLSearchParams({
                    page: currentPage,
                    limit: currentLimit,
                    search: currentSearch,
                    status: currentStatus === 'all' ? '' : currentStatus
                });

                const response = await fetch(`/admin/teachers?${params}`);
                const data = await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(data.msg || 'فشل في جلب البيانات');
                }

                updateStats(data.data.stats);
                renderTeachersTable(data.data.teachers);
                updatePagination(data.data.pagination);

            } catch (error) {
                console.error('Error fetching teachers:', error);
                showToast('❌ حدث خطأ أثناء تحميل البيانات', 'failed');
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="px-3 py-8 text-center text-red-500">
                            <i class="material-icons-outlined text-4xl">error_outline</i>
                            <p class="mt-2">فشل في تحميل البيانات</p>
                        </td>
                    </tr>
                `;
            }
        }

        function updateStats(stats) {
            document.getElementById('stat-total').textContent = stats.totalTeachers || 0;
            document.getElementById('stat-active').textContent = stats.totalActiveTeachers || 0;
            document.getElementById('stat-suspended').textContent = stats.totalSuspendedTeachers || 0;
            document.getElementById('stat-rating').textContent = stats.averageRating || 0;
        }

        function renderTeachersTable(teachers) {
            if (!teachers || teachers.length === 0) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="px-3 py-8 text-center text-gray-500">
                            <i class="material-icons-outlined text-4xl">inbox</i>
                            <p class="mt-2">لا توجد بيانات لعرضها</p>
                        </td>
                    </tr>
                `;
                return;
            }

            tableBody.innerHTML = teachers.map(teacher => `
                <tr class="data-table-row">
                    <td class="px-3 py-4 whitespace-nowrap">
                        <div class="flex items-center gap-3">
                            <div class="h-10 w-10 rounded-full bg-primary/20 flex items-center justify-center text-primary font-bold">
                                ${teacher.name.charAt(0)}
                            </div>
                            <div class="min-w-0">
                                <p class="font-bold text-gray-800 dark:text-white">${teacher.name}</p>
                                <p class="text-xs text-gray-500 dark:text-gray-400 teacher-contact-info">${teacher.phone}</p>
                            </div>
                        </div>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-600 dark:text-gray-300">${teacher.email || '-'}</td>
                    <td class="px-3 py-4 whitespace-nowrap font-medium">${teacher.subject || '-'}</td>
                    <td class="px-3 py-4 whitespace-nowrap text-center">${teacher.studentsCount || 0}</td>
                    <td class="px-3 py-4 whitespace-nowrap text-center">
                        <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ${
                            teacher.status === 'نشط' 
                            ? 'bg-green-100 text-green-800 dark:bg-green-700 dark:text-green-100' 
                            : 'bg-red-100 text-red-800 dark:bg-red-700 dark:text-red-100'
                        }">
                            ${teacher.status}
                        </span>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap text-left">
                        <div class="relative inline-block text-left">
                            <button class="action-dropdown-btn p-1 rounded-full text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors" onclick="event.stopPropagation(); toggleDropdown(this)">
                                <i class="material-icons-outlined text-lg">more_vert</i>
                            </button>
                            <div class="action-dropdown-menu hidden absolute left-0 z-10 w-40 mt-2 origin-top-right bg-light-card dark:bg-dark-card border border-gray-100 dark:border-gray-700 rounded-md shadow-lg py-1">
                                <a href="#" class="dropdown-item flex items-center px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 gap-2" onclick="event.preventDefault(); openEditModal('${teacher._id}', ${JSON.stringify(teacher).replace(/"/g, '&quot;')})">
                                    <i class="material-icons-outlined text-base">edit</i> تعديل
                                </a>
                                <a href="#" class="dropdown-item flex items-center px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-gray-50 dark:hover:bg-gray-700 gap-2" onclick="event.preventDefault(); deleteTeacher('${teacher._id}', '${teacher.name}')">
                                    <i class="material-icons-outlined text-base">delete</i> حذف
                                </a>
                            </div>
                        </div>
                    </td>
                </tr>
            `).join('');

            setupDropdowns();
        }

        function updatePagination(pagination) {
            const { page, limit, totalResults, totalPages } = pagination;
            
            const displayStart = totalResults === 0 ? 0 : (page - 1) * limit + 1;
            const displayEnd = Math.min(page * limit, totalResults);
            paginationInfo.textContent = `عرض ${displayStart} إلى ${displayEnd} من ${totalResults} نتيجة`;

            paginationControls.innerHTML = '';
            
            const prevBtn = document.createElement('button');
            prevBtn.textContent = 'السابق';
            prevBtn.className = `px-3 py-1 border border-gray-300 dark:border-gray-700 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors ${page === 1 ? 'opacity-50 cursor-not-allowed' : ''}`;
            prevBtn.disabled = page === 1;
            prevBtn.onclick = () => { if (page > 1) { currentPage--; fetchTeachers(); } };
            paginationControls.appendChild(prevBtn);

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= page - 1 && i <= page + 1)) {
                    const pageBtn = document.createElement('button');
                    pageBtn.textContent = i;
                    pageBtn.className = `px-3 py-1 rounded-lg transition-colors ${i === page ? 'bg-primary text-white' : 'border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700'}`;
                    pageBtn.onclick = () => { currentPage = i; fetchTeachers(); };
                    paginationControls.appendChild(pageBtn);
                } else if (i === page - 2 || i === page + 2) {
                    const dots = document.createElement('span');
                    dots.textContent = '...';
                    dots.className = 'px-1';
                    paginationControls.appendChild(dots);
                }
            }

            const nextBtn = document.createElement('button');
            nextBtn.textContent = 'التالي';
            nextBtn.className = `px-3 py-1 border border-gray-300 dark:border-gray-700 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors ${page === totalPages ? 'opacity-50 cursor-not-allowed' : ''}`;
            nextBtn.disabled = page === totalPages;
            nextBtn.onclick = () => { if (page < totalPages) { currentPage++; fetchTeachers(); } };
            paginationControls.appendChild(nextBtn);
        }

        // === Dropdown Management ===
        function toggleDropdown(buttonElement) {
            const dropdownMenu = buttonElement.nextElementSibling;
            
            document.querySelectorAll('.action-dropdown-menu').forEach(menu => {
                if (menu !== dropdownMenu) {
                    menu.classList.add('hidden');
                }
            });

            dropdownMenu.classList.toggle('hidden');
        }

        function setupDropdowns() {
            document.addEventListener('click', (e) => {
                if (!e.target.closest('.action-dropdown-btn') && !e.target.closest('.action-dropdown-menu')) {
                     document.querySelectorAll('.action-dropdown-menu').forEach(menu => {
                        menu.classList.add('hidden');
                    });
                }
            });
        }

        // === Modal Management ===
        function openModal(mode) {
            teacherModal.classList.remove('hidden');
            body.style.overflow = 'hidden'; 

            setTimeout(() => {
                teacherModal.classList.add('opacity-100');
                modalContent.classList.remove('translate-y-full');
                modalContent.classList.add('translate-y-0');
            }, 10);
            
            document.getElementById('form-mode').value = mode;
            
            if (mode === 'add') {
                modalTitle.textContent = 'إضافة مدرس جديد';
                teacherForm.reset();
                document.getElementById('teacher-id-field').value = '';
                document.getElementById('password-field-container').classList.remove('hidden');
                document.getElementById('teacher-password').required = true;
                document.getElementById('status-field-container').classList.add('hidden');
                document.getElementById('bio-field-container').classList.add('hidden');
                document.getElementById('submit-text').textContent = 'إضافة المعلم';
            }
        }

        function openEditModal(teacherId, teacherData) {
            const teacher = typeof teacherData === 'string' ? JSON.parse(teacherData) : teacherData;
            
            openModal('edit');
            modalTitle.textContent = 'تعديل بيانات المعلم';
            
            document.getElementById('teacher-id-field').value = teacherId;
            document.getElementById('teacher-name').value = teacher.name || '';
            document.getElementById('teacher-email').value = teacher.email || '';
            document.getElementById('teacher-phone').value = teacher.phone || '';
            document.getElementById('teacher-subject').value = teacher.subject || '';
            document.getElementById('teacher-status').value = teacher.status || 'نشط';
            document.getElementById('teacher-bio').value = teacher.bio || '';
            
            document.getElementById('password-field-container').classList.add('hidden');
            document.getElementById('teacher-password').required = false;
            document.getElementById('status-field-container').classList.remove('hidden');
            document.getElementById('bio-field-container').classList.remove('hidden');
            document.getElementById('submit-text').textContent = 'حفظ التغييرات';
        }

        function closeModal() {
            teacherModal.classList.remove('opacity-100');
            modalContent.classList.remove('translate-y-0');
            modalContent.classList.add('translate-y-full');
            
            setTimeout(() => {
                teacherModal.classList.add('hidden');
                body.style.overflow = ''; 
                teacherForm.reset();
            }, 300);
        }

        teacherModal.addEventListener('click', (e) => {
            if (e.target === teacherModal) closeModal();
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !teacherModal.classList.contains('hidden')) {
                closeModal();
            }
        });

        // === Form Submission ===
        teacherForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const submitBtn = document.getElementById('submit-btn');
            const submitText = document.getElementById('submit-text');
            const submitSpinner = document.getElementById('submit-spinner');
            const mode = document.getElementById('form-mode').value;
            const teacherId = document.getElementById('teacher-id-field').value;

            submitBtn.disabled = true;
            submitBtn.classList.add('btn-loading');
            submitSpinner.classList.remove('hidden');

            try {
                const formData = {
                    name: document.getElementById('teacher-name').value.trim(),
                    email: document.getElementById('teacher-email').value.trim(),
                    phone: document.getElementById('teacher-phone').value.trim(),
                    subject: document.getElementById('teacher-subject').value.trim(),
                };

                if (mode === 'add') {
                    formData.password = document.getElementById('teacher-password').value;
                } else {
                    formData.status = document.getElementById('teacher-status').value;
                    formData.bio = document.getElementById('teacher-bio').value.trim();
                    formData.avatar = '';
                }

                const url = mode === 'add' ? '/api/admin/teacher' : `/api/admin/teacher/${teacherId}`;
                const method = mode === 'add' ? 'POST' : 'PUT';

                const response = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(data.msg || 'فشل في حفظ البيانات');
                }

                showToast(data.msg, 'success');
                closeModal();
                fetchTeachers();

            } catch (error) {
                console.error('Error saving teacher:', error);
                showToast(error.message || '❌ حدث خطأ أثناء حفظ البيانات', 'failed');
            } finally {
                submitBtn.disabled = false;
                submitBtn.classList.remove('btn-loading');
                submitSpinner.classList.add('hidden');
            }
        });

        // === Delete Teacher ===
        async function deleteTeacher(teacherId, teacherName) {
            if (!confirm(`هل أنت متأكد من حذف المعلم "${teacherName}"؟\nلا يمكن التراجع عن هذا الإجراء.`)) {
                return;
            }

            try {
                const response = await fetch(`/api/admin/teacher/${teacherId}`, {
                    method: 'DELETE'
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(data.msg || 'فشل في حذف المعلم');
                }

                showToast(data.msg, 'success');
                fetchTeachers();

            } catch (error) {
                console.error('Error deleting teacher:', error);
                showToast(error.message || '❌ حدث خطأ أثناء حذف المعلم', 'failed');
            }
        }

        // === Search & Filter ===
        let searchTimeout;
        searchInput.addEventListener('input', (e) => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                currentSearch = e.target.value.trim();
                currentPage = 1;
                fetchTeachers();
            }, 500);
        });

        statusFilter.addEventListener('change', (e) => {
            currentStatus = e.target.value;
            currentPage = 1;
            fetchTeachers();
        });

        addTeacherBtn.addEventListener('click', () => openModal('add'));

        // === Initialize ===
        document.addEventListener('DOMContentLoaded', () => {
            fetchTeachers();
        });
    </script>
</body>
</html>