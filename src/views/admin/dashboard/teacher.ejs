<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة المدرسين | Teacher Management</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Almarai:wght@400;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Icons+Outlined&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Almarai', 'sans-serif'],
                    },
                    colors: {
                        primary: '#3B82F6', 
                        secondary: '#10B981', 
                        dark: { bg: '#111827', card: '#1F2937', text: '#F3F4F6' },
                        light: { bg: '#F3F4F6', card: '#FFFFFF', text: '#1F2937' }
                    },
                    keyframes: {
                        fadeInUp: {
                            '0%': { opacity: '0', transform: 'translateY(10px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        }
                    },
                    animation: {
                        fadeInUp: 'fadeInUp 0.5s ease-out forwards',
                    },
                }
            }
        }
    </script>

    <style>
        body { transition: background-color 0.3s, color 0.3s; min-height: 100vh; font-family: 'Almarai', sans-serif; }
        #sidebar { position: fixed; z-index: 50; top: 0; right: 0; height: 100%; transform: translateX(100%); transition: transform 0.3s ease-out; }
        .sidebar-open #sidebar { transform: translateX(0); }
        .sidebar-link.active { background-color: #3B82F6; color: white; }
        .dark .sidebar-link.active { background-color: #1E40AF; }

        .data-table-row { transition: background-color 0.2s; }
        .data-table-row:nth-child(even) { background-color: #F9FAFB; }
        .dark .data-table-row:nth-child(even) { background-color: #1F2937; }
        .data-table-row:hover { background-color: #E5E7EB; }
        .dark .data-table-row:hover { background-color: #374151; }
        
        .modal-overlay {
            background-color: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
            transition: opacity 0.3s ease;
        }
        .modal-content {
            transition: transform 0.3s ease, opacity 0.3s ease;
            max-height: 90vh; 
            overflow-y: auto;
            width: 95%; 
            max-width: 500px; 
        }

        .overflow-x-auto {
            overflow-x: auto;
        }

        .data-table-row td, .data-table-row th {
            min-width: 120px; 
        }
        
        .data-table-row td:first-child { 
             min-width: 240px;
        }
        
        .teacher-contact-info {
            display: block;
            white-space: nowrap;
        }
        
        .kpi-card-effect {
            transition: all 0.3s ease-in-out;
            cursor: pointer; 
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        }
        .kpi-card-effect.glow-primary:hover, .kpi-card-effect.glow-primary:focus-within {
            box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3), 0 4px 6px -4px rgba(59, 130, 246, 0.15); 
            transform: scale(1.01);
        }
        .kpi-card-effect.glow-primary:hover .kpi-value, .kpi-card-effect.glow-primary:focus-within .kpi-value { color: #3B82F6; }
        .kpi-card-effect.glow-green:hover, .kpi-card-effect.glow-green:focus-within {
            box-shadow: 0 10px 15px -3px rgba(34, 197, 94, 0.3), 0 4px 6px -4px rgba(34, 197, 94, 0.15); 
            transform: scale(1.01);
        }
        .kpi-card-effect.glow-green:hover .kpi-value, .kpi-card-effect.glow-green:focus-within .kpi-value { color: #22C55E; }
        .kpi-card-effect.glow-red:hover, .kpi-card-effect.glow-red:focus-within {
            box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.3), 0 4px 6px -4px rgba(239, 68, 68, 0.15);
            transform: scale(1.01);
        }
        .kpi-card-effect.glow-red:hover .kpi-value, .kpi-card-effect.glow-red:focus-within .kpi-value { color: #EF4444; }
        .kpi-card-effect.glow-yellow:hover, .kpi-card-effect.glow-yellow:focus-within {
            box-shadow: 0 10px 15px -3px rgba(245, 158, 11, 0.3), 0 4px 6px -4px rgba(245, 158, 11, 0.15); 
            transform: scale(1.01);
        }
        .kpi-card-effect.glow-yellow:hover .kpi-value, .kpi-card-effect.glow-yellow:focus-within .kpi-value { color: #F59E0B; }
        .dark .kpi-card-effect.glow-primary:hover, .dark .kpi-card-effect.glow-primary:focus-within { box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.4), 0 4px 6px -4px rgba(59, 130, 246, 0.2); }
        .dark .kpi-card-effect.glow-green:hover, .dark .kpi-card-effect.glow-green:focus-within { box-shadow: 0 10px 15px -3px rgba(34, 197, 94, 0.4), 0 4px 6px -4px rgba(34, 197, 94, 0.2); }
        .dark .kpi-card-effect.glow-red:hover, .dark .kpi-card-effect.glow-red:focus-within { box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.4), 0 4px 6px -4px rgba(239, 68, 68, 0.2); }
        .dark .kpi-card-effect.glow-yellow:hover, .dark .kpi-card-effect.glow-yellow:focus-within { box-shadow: 0 10px 15px -3px rgba(245, 158, 11, 0.4), 0 4px 6px -4px rgba(245, 158, 11, 0.2); }

        /* Toast Message من صفحة OTP */
        #toast-message {
            position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-150%);
            padding: 16px 28px; border-radius: 12px; color: white; font-weight: 800;
            opacity: 0; transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 100; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
            width: 90%; max-width: 450px; text-align: center;
        }
        .toast-show { opacity: 1 !important; transform: translateX(-50%) translateY(0) !important; }
        .toast-success { background-color: #15803d; }
        .toast-info { background-color: #2563eb; }
        .toast-failed { background-color: #b91c1c; }

        .spinner {
            border: 3px solid rgba(255, 255, 255, 0.3); border-top: 3px solid white;
            border-radius: 50%; width: 22px; height: 22px;
            animation: spin 0.8s linear infinite;
            display: inline-block;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        .btn-loading { opacity: 0.7; cursor: not-allowed; }
    </style>
</head>

