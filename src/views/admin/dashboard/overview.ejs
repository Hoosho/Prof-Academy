    <script>
        // === Global Variables ===
        const html = document.documentElement;
        const body = document.body;
        
        // Sidebar Elements
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');
        const toggleSidebarBtn = document.getElementById('toggle-sidebar-btn');
        const closeSidebarBtn = document.getElementById('close-sidebar-btn'); 

        // Dropdown Elements
        const profileBtn = document.getElementById('profile-btn');
        const profileDropdown = document.getElementById('profile-dropdown');
        const notificationBtn = document.getElementById('notification-btn');
        const notificationDropdown = document.getElementById('notification-dropdown');
        const themeBtn = document.getElementById('theme-btn');
        const themeIcon = themeBtn.querySelector('i');
        const markReadBtn = document.getElementById('mark-read-btn'); 

        // === 1. إدارة الشريط الجانبي (Sidebar) ===
        function toggleSidebar() {
            body.classList.toggle('sidebar-open');
            
            if (body.classList.contains('sidebar-open')) {
                sidebar.classList.remove('transform', 'translate-x-full'); 
                sidebar.classList.add('translate-x-0'); 
                sidebarOverlay.classList.remove('hidden');
                body.style.overflow = 'hidden'; 
            } else {
                sidebar.classList.remove('translate-x-0');
                sidebar.classList.add('transform', 'translate-x-full'); 
                sidebarOverlay.classList.add('hidden');
                body.style.overflow = ''; 
            }
        }

        // ربط الأحداث (Event Listeners)
        toggleSidebarBtn.addEventListener('click', toggleSidebar);
        closeSidebarBtn.addEventListener('click', toggleSidebar);
        sidebarOverlay.addEventListener('click', toggleSidebar);
        
        // === 2. إدارة الثيم (Dark/Light Mode) ===
        function updateThemeIcon() {
            themeIcon.textContent = html.classList.contains('dark') ? 'light_mode' : 'brightness_4';
        }

        // Initialization
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            html.classList.add('dark');
        } else {
            html.classList.remove('dark');
        }
        updateThemeIcon();

        // Event Listener
        themeBtn.addEventListener('click', () => {
            html.classList.toggle('dark');
            localStorage.theme = html.classList.contains('dark') ? 'dark' : 'light';
            updateThemeIcon();
            updateChartColors();
        });

        // === 3. إدارة قوائم الدروب داون (Profile & Notifications) ===
        function toggleDropdown(dropdown) {
            dropdown.classList.toggle('hidden');
        }

        profileBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleDropdown(profileDropdown);
            notificationDropdown.classList.add('hidden');
        });

        notificationBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleDropdown(notificationDropdown);
            profileDropdown.classList.add('hidden');
        });

        document.addEventListener('click', () => {
            profileDropdown.classList.add('hidden');
            notificationDropdown.classList.add('hidden');
        });

        // === 4. وظيفة "تعليم كمقروء" الوهمية (Dummy Mark as Read) ===
        markReadBtn.addEventListener('click', (e) => {
            e.preventDefault();
            alert('تم تعليم جميع الإشعارات كمقروءة! (هنا يتم إرسال طلب للباك إند)');
            notificationDropdown.classList.add('hidden');
        });
        
        // === 5. تنفيذ العداد (Count Up Effect) ===
        function countUp() {
            const counters = document.querySelectorAll('.counter-value');

            counters.forEach(counter => {
                const target = +counter.getAttribute('data-target');
                let start = 0;
                
                const duration = 1500; // مدة العد بالمللي ثانية
                const step = target / (duration / 10); 

                const updateCount = () => {
                    const increment = target < 100 ? 1 : step;
                    
                    if (start < target) {
                        start = Math.min(start + increment, target);
                        
                        counter.textContent = Math.ceil(start).toLocaleString('ar-EG'); 
                        
                        setTimeout(updateCount, 10);
                    } else {
                        counter.textContent = target.toLocaleString('ar-EG');
                    }
                };

                updateCount();
            });
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            createChart();
            setTimeout(countUp, 500);
        });
        
        // === 6. تحديث الرسم البياني (Chart.js) ===
        let revenueChart; 

        function createChart() {
            const ctx = document.getElementById('revenueChart');
            const labels = ['سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر', 'يناير', 'فبراير'];
            const data = [45000, 62000, 58000, 85200, 79000, 91000];

            const isDarkMode = html.classList.contains('dark');
            const gridColor = isDarkMode ? '#374151' : '#E5E7EB';
            const tickColor = isDarkMode ? '#D1D5DB' : '#6B7280';

            revenueChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'الإيرادات بالجنيه',
                        data: data,
                        backgroundColor: '#3B82F6',
                        borderRadius: 6,
                        hoverBackgroundColor: '#1D4ED8'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            rtl: true,
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + context.formattedValue + ' ج.م';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: gridColor },
                            ticks: {
                                color: tickColor,
                                callback: function(value) {
                                    return value.toLocaleString('ar-EG');
                                }
                            }
                        },
                        x: {
                             grid: { display: false },
                            ticks: { color: tickColor }
                        }
                    }
                }
            });
        }
        
        function updateChartColors() {
            if (revenueChart) {
                const isDarkMode = html.classList.contains('dark');
                const gridColor = isDarkMode ? '#374151' : '#E5E7EB';
                const tickColor = isDarkMode ? '#D1D5DB' : '#6B7280';

                revenueChart.options.scales.y.grid.color = gridColor;
                revenueChart.options.scales.y.ticks.color = tickColor;
                revenueChart.options.scales.x.ticks.color = tickColor;
                
                revenueChart.update();
            }
        }
    </script>
</body>
</html>