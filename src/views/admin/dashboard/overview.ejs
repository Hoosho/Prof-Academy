<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم المدير | Admin Dashboard</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Almarai:wght@400;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Icons+Outlined&display=swap" rel="stylesheet">
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script>
        // تهيئة إعدادات Tailwind CSS
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Almarai', 'sans-serif'],
                    },
                    colors: {
                        primary: '#3B82F6', 
                        secondary: '#10B981', 
                        dark: { bg: '#111827', card: '#1F2937', text: '#F3F4F6' },
                        light: { bg: '#F3F4F6', card: '#FFFFFF', text: '#1F2937' }
                    },
                    keyframes: {
                        fadeInUp: {
                            '0%': { opacity: '0', transform: 'translateY(10px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        }
                    },
                    animation: {
                        fadeInUp: 'fadeInUp 0.5s ease-out forwards',
                    },
                }
            }
        }
    </script>

    <style>
        /* ستايلات الـ Dashboard الأساسية */
        body { 
            transition: background-color 0.3s, color 0.3s; 
            min-height: 100vh;
        }
        #sidebar {
            position: fixed;
            z-index: 50;
            top: 0;
            right: 0;
            height: 100%;
            transform: translateX(100%);
            transition: transform 0.3s ease-out;
        }
        .sidebar-open #sidebar {
            transform: translateX(0);
        }
        .sidebar-link.active { background-color: #3B82F6; color: white; }
        .dark .sidebar-link.active { background-color: #1E40AF; }

        /* كلاسات التأخير الزمني */
        .animate-delay-1 { animation-delay: 0.1s; }
        .animate-delay-2 { animation-delay: 0.2s; }
        .animate-delay-3 { animation-delay: 0.3s; }
        .animate-delay-4 { animation-delay: 0.4s; }
        .animate-delay-5 { animation-delay: 0.5s; }

        /* إعداد الـ Counter */
        .counter-value {
            min-width: 50px; 
            /* هام: خاصية الانتقال لتأثير اللون */
            transition: color 0.3s ease-in-out; 
            /* اللون الافتراضي في وضع الـ Light Mode */
            color: #1F2937; /* light:text-light-text */
        }
        
        /* اللون الافتراضي في وضع الـ Dark Mode */
        .dark .counter-value {
            color: #F3F4F6; /* dark:text-dark-text */
        }

        /* === ⭐️ الإصلاح النهائي لـ Hover/Focus: تغيير لون الرقم (Counter Value) === */
        
        /* الأزرق (Primary) */
        .kpi-card-effect.glow-primary:hover .counter-value,
        .kpi-card-effect.glow-primary:focus-within .counter-value,
        .kpi-card-effect.glow-primary:active .counter-value {
            color: #3B82F6; 
        }

        /* الأخضر الـ Secondary (للمدرسين) */
        .kpi-card-effect.glow-secondary:hover .counter-value,
        .kpi-card-effect.glow-secondary:focus-within .counter-value,
        .kpi-card-effect.glow-secondary:active .counter-value {
            color: #10B981; 
        }

        /* الأخضر العادي (للإيرادات) */
        .kpi-card-effect.glow-green:hover .counter-value,
        .kpi-card-effect.glow-green:focus-within .counter-value,
        .kpi-card-effect.glow-green:active .counter-value {
            color: #22C55E; /* Green-500 */
        }

        /* الأحمر (للمراجعة) */
        .kpi-card-effect.glow-red:hover .counter-value,
        .kpi-card-effect.glow-red:focus-within .counter-value,
        .kpi-card-effect.glow-red:active .counter-value {
            color: #EF4444; /* Red-500 */
        }

        /* === اللمسة الفنية: تأثير الـ GLOW على Hover, Focus, & Active (Light Mode) === */
        
        .kpi-card-effect {
            transition: all 0.3s ease-in-out;
            cursor: pointer; 
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        }
        
        /* Glow الأزرق (للطلاب) - الفاتح */
        .kpi-card-effect.glow-primary:hover, .kpi-card-effect.glow-primary:focus-within, .kpi-card-effect.glow-primary:active {
            box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3), 0 4px 6px -4px rgba(59, 130, 246, 0.15); 
            transform: scale(1.01);
        }
        
        /* Glow الأخضر (للمدرسين) - الفاتح */
        .kpi-card-effect.glow-secondary:hover, .kpi-card-effect.glow-secondary:focus-within, .kpi-card-effect.glow-secondary:active {
            box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.3), 0 4px 6px -4px rgba(16, 185, 129, 0.15); 
            transform: scale(1.01);
        }

        /* Glow الأخضر (للإيرادات) - الفاتح */
        .kpi-card-effect.glow-green:hover, .kpi-card-effect.glow-green:focus-within, .kpi-card-effect.glow-green:active {
            box-shadow: 0 10px 15px -3px rgba(34, 197, 94, 0.3), 0 4px 6px -4px rgba(34, 197, 94, 0.15); 
            transform: scale(1.01);
        }

        /* Glow الأحمر (للمراجعة) - الفاتح */
        .kpi-card-effect.glow-red:hover, .kpi-card-effect.glow-red:focus-within, .kpi-card-effect.glow-red:active {
            box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.3), 0 4px 6px -4px rgba(239, 68, 68, 0.15);
            transform: scale(1.01);
        }

        /* ********** إصلاح الـ DARK MODE GLOW ********** */

        /* Glow الأزرق (للطلاب) - الداكن */
        .dark .kpi-card-effect.glow-primary:hover, .dark .kpi-card-effect.glow-primary:focus-within, .dark .kpi-card-effect.glow-primary:active {
            box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.4), 0 4px 6px -4px rgba(59, 130, 246, 0.2);
            transform: scale(1.01);
        }
        
        /* Glow الأخضر (للمدرسين) - الداكن */
        .dark .kpi-card-effect.glow-secondary:hover, .dark .kpi-card-effect.glow-secondary:focus-within, .dark .kpi-card-effect.glow-secondary:active {
            box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.4), 0 4px 6px -4px rgba(16, 185, 129, 0.2);
            transform: scale(1.01);
        }

        /* Glow الأخضر (للإيرادات) - الداكن */
        .dark .kpi-card-effect.glow-green:hover, .dark .kpi-card-effect.glow-green:focus-within, .dark .kpi-card-effect.glow-green:active {
            box-shadow: 0 10px 15px -3px rgba(34, 197, 94, 0.4), 0 4px 6px -4px rgba(34, 197, 94, 0.2); 
            transform: scale(1.01);
        }

        /* Glow الأحمر (للمراجعة) - الداكن */
        .dark .kpi-card-effect.glow-red:hover, .dark .kpi-card-effect.glow-red:focus-within, .dark .kpi-card-effect.glow-red:active {
            box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.4), 0 4px 6px -4px rgba(239, 68, 68, 0.2);
            transform: scale(1.01);
        }
        
        /* إزالة خط التركيز الافتراضي */
        .kpi-card-effect:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.5); 
        }

    </style>
</head>

